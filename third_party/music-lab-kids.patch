+// kids.sauravsood.com: the original icon font was loaded from another site.
+// These icons are plain characters instead, so nothing is fetched.
+@mixin kid-icon($char) {
+	&:before {
+		font-family: "Apple Color Emoji", "Segoe UI Symbol", "Noto Color Emoji", sans-serif;
+		font-style: normal;
+		font-weight: normal;
+		text-decoration: none;
+		text-transform: none;
+		content: $char;
+	}
+}
+.icon-svg_play { @include kid-icon("\25B6\FE0E"); }
+.icon-svg_pause { @include kid-icon("\275A\275A"); }
+.icon-svg_piano { @include kid-icon("\1F3B9"); }
+.icon-svg_harp { @include kid-icon("\1F3B6"); }
+.icon-svg_metronome { @include kid-icon("\1F941"); }
+.icon-svg_close, .icon-svg_close-button { @include kid-icon("\2715"); }
+.icon-svg_left_arrow, .icon-svg_back_arrow { @include kid-icon("\25C0\FE0E"); }
+.icon-svg_right_arrow, .icon-svg_go_arrow { @include kid-icon("\25B6\FE0E"); }
+.icon-svg_slow_man { @include kid-icon("\1F422"); }
+.icon-svg_fast_man { @include kid-icon("\1F407"); }
+.icon-svg_record { @include kid-icon("\25CF"); }
+.icon-svg_no_record { @include kid-icon("\25CB"); }
+.icon-svg_wave_form { @include kid-icon("\3030"); }
